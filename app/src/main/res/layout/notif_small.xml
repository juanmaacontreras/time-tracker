<?xml version="1.0" encoding="utf-8"?>
<!-- Vista colapsada (la que más se ve): swatch, qué corre, cronómetro y los dos botones
     redondos de 36dp, separados para no parar por error al querer pausar. Desde Android
     12 el sistema ya pone a la izquierda su círculo con el ícono, teñido con el color de
     la actividad (setColor): ahí el swatch propio sobra y Notifs lo oculta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <include
        android:id="@+id/n_swatch"
        layout="@layout/rv_swatch"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/n_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Actividad" />

        <TextView
            android:id="@+id/n_eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cronometrando" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/n_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="18sp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:text="0:00" />

    <FrameLayout
        android:id="@+id/n_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/circle_primary"
        android:contentDescription="Pausar"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/n_pause_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/n_stop"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/circle_tonal"
        android:contentDescription="Parar"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/n_stop_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stop" />
    </FrameLayout>
</LinearLayout>

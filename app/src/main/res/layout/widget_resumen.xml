<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Resumen: el encabezado del Resumen de la app en chico (período, total en
     "5 h 20 m" y cómo viene contra el período anterior) y debajo el desglose por
     actividad (filas de layout/widget_resumen_row.xml, armadas en ResumenWidget según el
     alto). Tocar el fondo abre la app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hoy"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/seg_track"
            android:padding="2dp">

            <TextView
                android:id="@+id/w2_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textStyle="bold"
                android:text="Día"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/w2_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textStyle="bold"
                android:text="Semana"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/w2_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textStyle="bold"
                android:text="Mes"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w2_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 m"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="-0.01"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/w2_cmp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text=""
        android:textColor="@color/muted"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/w2_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w2_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="32dp"
        android:text=""
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w2_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Sin tiempo registrado"
        android:textColor="@color/muted"
        android:textSize="12.5sp"
        android:visibility="gone" />
</LinearLayout>

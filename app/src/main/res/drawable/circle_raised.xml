<?xml version="1.0" encoding="utf-8"?>
<!-- "Parar" del widget cuando la tarjeta no lleva botones blancos (actividad de color
     claro): "levantado" (raised), para que no se pierda contra el fondo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/raised" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la tarjeta de lo que corre en el widget: blanco, se tiñe en runtime con el
     color de la actividad (setColorFilter). Color lleno: elegido por el usuario entre
     teñida / neutra / lleno. -->

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Bitacora" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorAccent">@color/indigo</item>
        <!-- Barras del sistema del mismo tono que el fondo, con íconos oscuros. -->
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Diálogos con la misma estética "papel/tinta" del resto de la app, en vez del
         gris genérico de AppCompat. Los colores referenciados ya tienen variante
         values-night, así que se adapta solo al tema oscuro. Los botones los termina
         de estilar MainActivity.styleDialog (el lleno usa el acento del perfil). -->
    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/inkSoft</item>
        <item name="colorAccent">@color/indigo</item>
        <item name="android:backgroundDimAmount">0.38</item>
    </style>
</resources>

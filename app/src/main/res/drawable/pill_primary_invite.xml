<?xml version="1.0" encoding="utf-8"?>
<!-- "Seguir" en pausa: la píldora principal con el anillo "live" para invitar a retomar
     (sustituto estático del pulso, RemoteViews no anima). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/indigo" />
    <corners android:radius="22dp" />
    <stroke android:width="2dp" android:color="@color/live" />
</shape>

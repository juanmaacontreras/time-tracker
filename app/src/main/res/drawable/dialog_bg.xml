<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de los diálogos: misma superficie que las tarjetas, esquinas amplias. El
     inset deja el margen lateral que AlertDialog no agrega por su cuenta. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetRight="16dp"
    android:insetTop="24dp"
    android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/card" />
        <corners android:radius="28dp" />
    </shape>
</inset>

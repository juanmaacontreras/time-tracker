<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta Nord (claro = "Snow Storm"; oscuro, en values-night = "Polar Night").
         Superficies sin bordes: la jerarquía la dan los tonos (paper < card) y surface2
         para pistas y campos. Mismos nombres y valores que las variables CSS de
         web/index.html. Acento = Frost; pausado / borrar = Aurora. -->
    <color name="paper">#FFECEFF4</color>
    <color name="card">#FFFAFBFC</color>
    <color name="surface2">#FFE5E9F0</color>
    <!-- Opción activa de un control segmentado ("levantada" sobre surface2). -->
    <color name="raised">#FFFAFBFC</color>
    <color name="ink">#FF2E3440</color>
    <color name="inkSoft">#FF4C566A</color>
    <color name="muted">#FF7A869B</color>
    <color name="line">#FFD8DEE9</color>
    <color name="grid">#FFE5E9F0</color>
    <color name="indigo">#FF5E81AC</color>
    <!-- Frost más intenso que el acento, para que "corriendo" se distinga de un vistazo. -->
    <color name="live">#FF3F86B0</color>
    <color name="pausedColor">#FFC2784F</color>
    <!-- Fondos tenues de "corriendo" / "pausado" para los widgets (RemoteViews no puede
         mezclar colores en tiempo de ejecución como la app). -->
    <color name="liveSoft">#FFE2ECF3</color>
    <color name="pausedSoft">#FFF5EAE3</color>
    <color name="danger">#FFBF616A</color>
    <!-- Texto/ícono sobre un fondo de acento lleno. -->
    <color name="onAccent">#FFFFFFFF</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Fondo fijo del ícono adaptativo (no cambia con el tema del sistema). -->
    <color name="ic_bg">#FF2F4B8F</color>
</resources>

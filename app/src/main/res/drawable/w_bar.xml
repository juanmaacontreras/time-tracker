<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de proporción del widget Resumen, con las dos puntas redondeadas. <scale> (no
     <clip>) para que el tramo lleno conserve la punta redonda. El indigo es el respaldo:
     desde API 31 se tiñe con el color de la actividad (setProgressTintList). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/surface2" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape>
                <solid android:color="@color/indigo" />
                <corners android:radius="3dp" />
            </shape>
        </scale>
    </item>
</layer-list>
